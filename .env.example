# إعدادات لوحة الإدارة (/admin)
# ===============================================================
# انسخ هذا الملف إلى `.env.local` واملأ ما تحتاجه:
#
#     cp .env.example .env.local
#
# `.env.local` لا يُرفع مع المشروع (مستثنى في .gitignore).
# على Vercel تُضبط هذه القيم في:
#     Project → Settings → Environment Variables


# ---------------------------------------------------------------
# الدخول
# ---------------------------------------------------------------

# كلمة سرّ الدخول إلى /admin — الافتراضي 123456
# غيّرها حتماً إن كانت اللوحة منشورة على الإنترنت.
ADMIN_PASSWORD=123456

# سرّ توقيع الجلسات. إن تركته فارغاً يُشتقّ من كلمة السرّ، فتبطل
# كل الجلسات تلقائياً عند تغييرها. اضبطه في الإنتاج بسلسلة عشوائية:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SECRET=

# عمر جلسة الدخول بالساعات (الافتراضي 12)
# ADMIN_SESSION_HOURS=12


# ---------------------------------------------------------------
# أين تُحفظ التغييرات
# ---------------------------------------------------------------
# اللوحة تختار آلياً: وُجد GITHUB_TOKEN و GITHUB_REPO ⇒ تُودع
# التغييرات في المستودع (وضع Vercel)، وإلا تكتب على قرص الجهاز.
#
#   محلياً على جهازك  : اترك متغيّرات GitHub فارغة. تُكتب الملفات
#                       مباشرة، ويعمل زرّ توليد PDF (يحتاج Word).
#   منشور على Vercel  : اضبطها. نظام الملفات هناك للقراءة فقط،
#                       فتُودَع التغييرات في المستودع وتُعيد Vercel
#                       النشر تلقائياً خلال دقيقة أو دقيقتين.

# رمز وصول من GitHub بصلاحية الكتابة على المستودع.
# أنشئه من: GitHub → Settings → Developer settings →
#           Personal access tokens → Fine-grained tokens
# واختر المستودع، وامنحه صلاحية:  Contents: Read and write
# GITHUB_TOKEN=

# المستودع المنشور، بصيغة owner/repo
# GITHUB_REPO=Bshara12/Digital-Library

# الفرع الذي تنشر منه Vercel (الافتراضي main)
# GITHUB_BRANCH=main

# فرض وضع معيّن بدل الاختيار الآلي: local أو github
# ADMIN_STORAGE=

# نطاق واجهة GitHub — يُضبط فقط مع GitHub Enterprise
# GITHUB_API_URL=https://api.github.com
