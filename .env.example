# إعدادات لوحة الإدارة (/admin)
# ---------------------------------------------------------------
# كلّها اختيارية — اللوحة تعمل بلا هذا الملف أصلاً. انسخه إلى
# `.env.local` واملأه إن أردت تغيير الافتراضيات:
#
#     cp .env.example .env.local
#
# `.env.local` لا يُرفع مع المشروع (مستثنى في .gitignore).

# كلمة سرّ الدخول إلى /admin
# الافتراضي: 123456 — مناسب للتشغيل على جهازك. غيّرها حتماً إن
# عرّضت اللوحة على الإنترنت.
ADMIN_PASSWORD=123456

# سرّ توقيع الجلسات. إن تركته فارغاً يُشتقّ من كلمة السرّ، فتبطل
# كل الجلسات تلقائياً عند تغييرها. اضبطه بسلسلة عشوائية طويلة في
# الإنتاج:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SECRET=

# عمر جلسة الدخول بالساعات (الافتراضي 12)
# ADMIN_SESSION_HOURS=12
